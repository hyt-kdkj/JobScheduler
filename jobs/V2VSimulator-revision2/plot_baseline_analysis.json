{
  "defaults": {
    "project": "V2VSimulator-revision2"
  },
  "jobs": [
    {
      "name": "revision2_plot_baseline_highway_{num_vehicles}_analysis",
      "command": "python3 plot_evaluation.py --agents SPS IPMI --scenario highway --num-vehicles {num_vehicles} --analysis-only",
      "matrix": {
        "num_vehicles": [
          120
        ]
      }
    },
    {
      "name": "revision2_plot_baseline_urban_{num_vehicles}_analysis",
      "command": "python3 plot_evaluation.py --agents SPS IPMI --scenario urban --num-vehicles {num_vehicles} --analysis-only",
      "matrix": {
        "num_vehicles": [
          200
        ]
      }
    }
  ]
}
